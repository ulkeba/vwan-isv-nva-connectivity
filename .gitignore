# Terraform working directories
.terraform/
terraform.tfstate.d/

# Terraform state and state locks
*.tfstate
*.tfstate.*
*.tfstate.lock.info

# Saved plans
*.tfplan
*.plan
tfplan

# Terraform crash logs
crash.log
crash.*.log

# Local Terraform overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local Terraform CLI configuration
.terraformrc
terraform.rc

# Environment configuration. Only the sanitized demo files are trackable.
*.tfvars
*.tfvars.json
!demo.tfvars
env_*.sh
!env_demo.sh

# Automatically loaded variable files are always local.
*.auto.tfvars
*.auto.tfvars.json

# Verification output
evidence*/

# Local environment and credential files
.env
.env.*
!.env.example
*.pem
*.pfx
*.p12

# Logs, temporary files, and local backups
*.log
*.tmp
*.temp
*.bak
*.orig
*~
*_bkp

# Editor and IDE settings
.vscode/
.idea/
*.code-workspace
*.swp
*.swo

# Operating-system metadata
.DS_Store
Thumbs.db
