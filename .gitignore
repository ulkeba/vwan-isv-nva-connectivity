local.tfvars
local.tfvars.json
*.local.tfvars
*.local.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# Verification output
evidence*/

# Local environment and credential files
.env
.env.*
!.env.example
*.pem
*.pfx
*.p12

# Logs, temporary files, and local backups
*.log
*.tmp
*.temp
*.bak
*.orig
*~
*_bkp

# Editor and IDE settings
.vscode/
.idea/
*.code-workspace
*.swp
*.swo

# Operating-system metadata
.DS_Store
Thumbs.db
